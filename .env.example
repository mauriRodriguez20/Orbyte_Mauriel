# Copia este archivo como .env en la raíz del repositorio y completa los valores.
# El archivo .env no se sube a git. En producción estos valores se configuran
# en los paneles de Render (backend) y Vercel (frontend), nunca en el código.

# --- Backend (FastAPI) ---

# Con "produccion" no se acepta localhost por CORS ni se crea el administrador con la
# contraseña de desarrollo. Render lo define en render.yaml.
ENTORNO=desarrollo

# Cadena de conexión de PostgreSQL.
# Formato: postgresql://usuario:contraseña@host:5432/nombre_bd
DATABASE_URL=

# URL de PostgreSQL para las pruebas de integración: una base aparte, solo para pruebas.
# Formato: postgresql://usuario:contraseña@localhost:5432/orbyte_test
# pytest la lee de este archivo (tests/conftest.py). Si además está exportada en la
# terminal, manda la exportada.
# NUNCA debe apuntar a Render ni a una base con datos reales: las pruebas vacían todas las
# tablas. Por eso pytest se niega a ejecutarse si esta URL es la misma base que DATABASE_URL,
# si el servidor es de Render o si el nombre de la base no termina en _test.
# Si se deja vacía, las pruebas de integración se omiten. SQLite no sirve: el esquema es de PostgreSQL.
TEST_DATABASE_URL=

# Clave para firmar los JWT. Genera una propia con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Minutos de validez del token de acceso.
JWT_EXPIRES_MIN=60

# Credenciales del administrador inicial: define valores solo en tu .env local
# o en el panel de variables del servicio. Se dejan vacías en esta plantilla.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Orígenes permitidos por CORS, separados por coma.
# En local es el servidor de Next.js; en Render, el dominio de Vercel.
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Next.js) ---

# URL base de la API que consume el frontend. next.config.ts la expone al navegador.
VITE_API_URL=http://localhost:8000
